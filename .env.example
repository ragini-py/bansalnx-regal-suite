# Copy to .env and adjust for your environment. Never commit .env.

# Base URL of the bansalnx-backend API (see e:\bansalnx\backend).
VITE_API_URL=http://localhost:4000/api

# Razorpay public key — replace with your real key when connected.
VITE_RAZORPAY_KEY_ID=rzp_test_dummy_key_id

# Shiprocket pincode check is server-side only; no public key is exposed here.
